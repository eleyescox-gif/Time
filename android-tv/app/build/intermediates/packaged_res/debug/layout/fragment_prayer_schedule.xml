<?xml version="1.0" encoding="utf-8"?>
<!--
  Prayer Schedule Fragment Layout
  1. সবার উপরে: মসজিদের নাম + তারিখ
  2. তার পর: বড় করে সময় (ঘড়ি + সেকেন্ড + AM/PM)
  3. নিচে: ফজর, সূর্যোদয়, যোহর, আসর, মাগরিব, এশা (৬টি কার্ড)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- ═══ ১. সবার উপরের দিকে: মসজিদের নাম + তারিখ ═══ -->
    <LinearLayout
        android:id="@+id/sectionMosqueHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/tvScheduleMosqueName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mosque_name_default"
            android:textColor="@color/gold"
            android:textSize="30sp"
            android:fontFamily="serif"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/tvScheduleDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="আজকের তারিখ"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- ═══ ২. তার পর: বড় করে সময় ═══ -->
    <LinearLayout
        android:id="@+id/sectionBigClock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="12dp">

        <!-- Time + Seconds + AM/PM -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvBigClockMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="64sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/tvBigClockSeconds"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=":00"
                android:textColor="@color/gold"
                android:textSize="32sp"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:layout_marginStart="4dp" />

            <TextView
                android:id="@+id/tvBigClockAmPm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AM"
                android:textColor="@color/gold"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Current Waqt Badge -->
        <TextView
            android:id="@+id/tvCurrentWaqtBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="চলমান ওয়াক্ত: ফজর"
            android:textColor="@color/accent_green"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_prayer_row"
            android:paddingHorizontal="14dp"
            android:paddingVertical="3dp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- ═══ ৩. ফজর, সূর্যোদয়, যোহর, আসর, মাগরিব, এশা (৬টি কার্ড) ═══ -->
    <LinearLayout
        android:id="@+id/sectionPrayersRow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- ১. ফজর কার্ড -->
        <LinearLayout
            android:id="@+id/cardFajr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_prayer_row"
            android:gravity="center"
            android:padding="8dp"
            android:layout_margin="4dp"
            android:focusable="true"
            android:nextFocusRight="@id/cardSunrise">

            <TextView
                android:id="@+id/tvFajrName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ফজর"
                android:textColor="@color/gold"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@color/bg_header"
                android:layout_marginVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আজান"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFajrAzan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@color/bg_header"
                android:layout_marginVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="জামায়াত"
                android:textColor="@color/gold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFajrJamaat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/gold"
                android:textSize="26sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ২. সূর্যোদয় কার্ড -->
        <LinearLayout
            android:id="@+id/cardSunrise"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_prayer_row"
            android:gravity="center"
            android:padding="8dp"
            android:layout_margin="4dp"
            android:focusable="true"
            android:nextFocusLeft="@id/cardFajr"
            android:nextFocusRight="@id/cardDhuhr">

            <TextView
                android:id="@+id/tvSunriseName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="সূর্যোদয়"
                android:textColor="@color/gold"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@color/bg_header"
                android:layout_marginVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="সময়"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSunriseTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/gold"
                android:textSize="26sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@color/bg_header"
                android:layout_marginVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ইশরাক"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="নিষিদ্ধ সময়"
                android:textColor="#FFA726"
                android:textSize="13sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- ৩. যোহর কার্ড -->
        <LinearLayout
            android:id="@+id/cardDhuhr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_prayer_row"
            android:gravity="center"
            android:padding="8dp"
            android:layout_margin="4dp"
            android:focusable="true"
            android:nextFocusLeft="@id/cardSunrise"
            android:nextFocusRight="@id/cardAsr">

            <TextView
                android:id="@+id/tvDhuhrName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="যোহর"
                android:textColor="@color/gold"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@color/bg_header"
                android:layout_marginVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আজান"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDhuhrAzan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@color/bg_header"
                android:layout_marginVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="জামায়াত"
                android:textColor="@color/gold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvDhuhrJamaat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/gold"
                android:textSize="26sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ৪. আসর কার্ড -->
        <LinearLayout
            android:id="@+id/cardAsr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_prayer_row"
            android:gravity="center"
            android:padding="8dp"
            android:layout_margin="4dp"
            android:focusable="true"
            android:nextFocusLeft="@id/cardDhuhr"
            android:nextFocusRight="@id/cardMaghrib">

            <TextView
                android:id="@+id/tvAsrName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আসর"
                android:textColor="@color/gold"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@color/bg_header"
                android:layout_marginVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আজান"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAsrAzan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@color/bg_header"
                android:layout_marginVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="জামায়াত"
                android:textColor="@color/gold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvAsrJamaat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/gold"
                android:textSize="26sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ৫. মাগরিব কার্ড -->
        <LinearLayout
            android:id="@+id/cardMaghrib"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_prayer_row"
            android:gravity="center"
            android:padding="8dp"
            android:layout_margin="4dp"
            android:focusable="true"
            android:nextFocusLeft="@id/cardAsr"
            android:nextFocusRight="@id/cardIsha">

            <TextView
                android:id="@+id/tvMaghribName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="মাগরিব"
                android:textColor="@color/gold"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@color/bg_header"
                android:layout_marginVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আজান"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMaghribAzan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@color/bg_header"
                android:layout_marginVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="জামায়াত"
                android:textColor="@color/gold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMaghribJamaat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/gold"
                android:textSize="26sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ৬. এশা কার্ড -->
        <LinearLayout
            android:id="@+id/cardIsha"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_prayer_row"
            android:gravity="center"
            android:padding="8dp"
            android:layout_margin="4dp"
            android:focusable="true"
            android:nextFocusLeft="@id/cardMaghrib">

            <TextView
                android:id="@+id/tvIshaName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="এশা"
                android:textColor="@color/gold"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@color/bg_header"
                android:layout_marginVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="আজান"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvIshaAzan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp"
                android:background="@color/bg_header"
                android:layout_marginVertical="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="জামায়াত"
                android:textColor="@color/gold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvIshaJamaat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--"
                android:textColor="@color/gold"
                android:textSize="26sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
