<?xml version="1.0" encoding="utf-8"?>
<!-- Calendar Fragment Layout — Feature 8: Mode 2 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_primary"
    android:gravity="center"
    android:padding="40dp">

    <!-- Gregorian Date -->
    <TextView
        android:id="@+id/tvCalGregDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="সোমবার"
        android:textColor="@color/text_secondary"
        android:textSize="28sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvCalGregFull"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="১ জানুয়ারি, ২০২৫"
        android:textColor="@color/text_primary"
        android:textSize="56sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <View
        android:layout_width="80dp"
        android:layout_height="2dp"
        android:background="@color/gold"
        android:layout_marginBottom="32dp" />

    <!-- Hijri Date -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="হিজরি তারিখ"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvCalHijriDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="১ মুহররম, ১৪৪৬ হিজরি"
        android:textColor="@color/gold"
        android:textSize="36sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:layout_marginBottom="32dp" />

    <!-- Jummah Notice (only visible on Friday) -->
    <TextView
        android:id="@+id/tvCalJummah"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🕌 আজ জুমু'আর দিন — আল্লাহর রহমত বর্ষিত হোক"
        android:textColor="@color/accent_green"
        android:textSize="22sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
