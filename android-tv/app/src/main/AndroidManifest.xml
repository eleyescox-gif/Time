<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ═══════════════════════════════════════════════
         PERMISSIONS
         ═══════════════════════════════════════════════ -->

    <!-- Feature 1: NTP time sync over network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Feature 3: Boot auto-start — TV restart হলে app auto launch -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Feature 4: Pre-Jamaat overlay notification -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Feature 7: Keep screen on (Screen never sleeps) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Foreground service for time-keeper (Android 9+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 12+ Exact Alarm Permissions (Zero-Crash Guard) -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />

    <!-- TV & Mobile Compatibility: Leanback and Touchscreen optional -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="false"
        android:theme="@style/Theme.MyMasjid.Light"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <!-- ═══════════════ MAIN ACTIVITY ═══════════════ -->
        <!-- Responsive on Mobile (Portrait) & TV (Landscape) without force-rotation -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">

            <!-- TV launcher intent (Android TV / Google TV home screen) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Mobile phone launcher intent (App drawer on Android phones) -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ═══════════════ SETTINGS ACTIVITY ═══════════════ -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />

        <!-- ═══════════════ FEATURE 3: BOOT RECEIVER ═══════════════ -->
        <!-- TV restart বা পাওয়ার অন হলে অটো-স্টার্ট -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <!-- China TV brands এর জন্য extra boot action -->
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- ═══════════════ FEATURE 1: TIME KEEPER SERVICE ═══════════════ -->
        <service
            android:name=".service.TimeKeeperService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ═══════════════ FEATURE 4: NOTIFICATION RECEIVER ═══════════════ -->
        <receiver
            android:name=".notification.NotificationBroadcastReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mymasjid.tv.SHOW_PRE_JAMAAT_BANNER" />
            </intent-filter>
        </receiver>

        <!-- ═══════════════ FEATURE 9: SCREENSAVER (DreamService) ═══════════════ -->
        <service
            android:name=".service.MasjidScreensaver"
            android:exported="true"
            android:label="@string/screensaver_label"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.service.dream"
                android:resource="@xml/screensaver" />
        </service>

    </application>

</manifest>
